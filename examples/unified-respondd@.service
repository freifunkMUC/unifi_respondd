# One instance per controller, the instance name selects the config:
#   /etc/unified-respondd/<instance>.yaml
#   systemctl enable --now unified-respondd@<instance>
#
# The config contains the controller credentials. LoadCredential (systemd >= 247)
# passes it to the unprivileged DynamicUser, so the file can stay root:root 0600.
# On older systemd replace DynamicUser/LoadCredential with a system user that can
# read the config and point UNIFIED_RESPONDD_CONFIG_FILE to the file directly.

[Unit]
Description=unified_respondd (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
LoadCredential=config.yaml:/etc/unified-respondd/%i.yaml
Environment=UNIFIED_RESPONDD_CONFIG_FILE=%d/config.yaml
ExecStart=/opt/unified-respondd/bin/unified-respondd
Restart=always
RestartSec=10

CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW

[Install]
WantedBy=multi-user.target
